<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Automated Infographic Generator - BKN' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/infographic.css">
</head>
<body class="bg-slate-50 text-slate-800">
  <% if (typeof user !== 'undefined' && user) { %>
    <header class="app-header">
      <div class="header-container">
        <div class="brand-group">
          <a href="/generator" class="brand-link">
            <img src="<%= user.logo_path || '/images/Logo_Badan_Kepegawaian_Negara.png' %>" alt="Logo BKN" class="header-logo">
            <div class="brand-text">
              <div class="brand-title">BADAN KEPEGAWAIAN NEGARA</div>
              <div class="brand-subtitle">Automated Infographic Generator • Kanreg V</div>
            </div>
          </a>
        </div>

        <nav class="header-nav">
          <a href="/generator" class="nav-link <%= typeof title !== 'undefined' && title.includes('Generator') ? 'active' : '' %>">
            <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
            <span>Generator</span>
          </a>
          <a href="/history" class="nav-link <%= typeof title !== 'undefined' && title.includes('Riwayat') ? 'active' : '' %>">
            <svg class="nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>Riwayat Arsip</span>
          </a>
          <div class="nav-divider"></div>
          <a href="/profile" class="user-profile-pill <%= typeof title !== 'undefined' && title.includes('Profil') ? 'active' : '' %>" title="Kelola Profil Pegawai">
            <div class="user-avatar-badge" style="overflow: hidden; padding: 0;">
              <img src="<%= user.avatar_path || '/images/default_avatar.png' %>" alt="<%= user.full_name %>" style="width: 100%; height: 100%; object-fit: cover; display: block;">
            </div>
            <div class="user-info-text">
              <div class="user-name"><%= user.full_name %></div>
              <div class="user-nip"><%= user.division || 'Pegawai BKN' %></div>
            </div>
          </a>
          <a href="/logout" class="btn-logout" title="Keluar dari Sistem">
            <svg style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
          </a>
        </nav>
      </div>
    </header>
  <% } %>
  <main class="main-content">
