<%- include('layouts/header') %>

<div style="max-width: 800px; margin: 3rem auto; padding: 0 1.25rem;">
  <div style="background: #ffffff; border-radius: 1rem; border: 1px solid #E2E8F0; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05); overflow: hidden; text-align: center;">
    
    <!-- Top banner -->
    <div style="background: linear-gradient(135deg, #071C33 0%, #0A2540 60%, #153E6B 100%); padding: 3rem 2rem; color: #ffffff; position: relative; border-bottom: 4px solid #D97706;">
      <div style="display: inline-flex; align-items: center; justify-content: center; width: 72px; height: 72px; border-radius: 18px; background: rgba(217, 119, 6, 0.2); border: 2px solid #D97706; margin-bottom: 1.25rem;">
        <svg style="width: 36px; height: 36px; color: #FBBF24;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
      </div>
      <h1 style="font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem; letter-spacing: -0.02em;">
        Modul Pembuat Notulen Rapat BKN
      </h1>
      <p style="color: #94A3B8; font-size: 0.95rem; max-width: 500px; margin: 0 auto; line-height: 1.5;">
        Sistem Perancangan & Dokumentasi Notulensi Rapat Kedinasan
      </p>
    </div>

    <!-- Content Body -->
    <div style="padding: 2.5rem 2rem;">
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #FEF3C7; color: #92400E; border: 1px solid #FCD34D; padding: 0.4rem 1rem; border-radius: 9999px; font-size: 0.8rem; font-weight: 700; margin-bottom: 1.5rem; text-transform: uppercase; letter-spacing: 0.04em;">
        <span style="width: 8px; height: 8px; background: #D97706; border-radius: 50%; display: inline-block;"></span>
        Fitur Dalam Tahap Persiapan
      </div>

      <h2 style="font-size: 1.25rem; font-weight: 700; color: #0A2540; margin-bottom: 0.75rem;">
        Halaman Notulen Sedang Dipersiapkan
      </h2>

      <p style="color: #475569; font-size: 0.925rem; line-height: 1.7; max-width: 560px; margin: 0 auto 2rem auto;">
        Modul pembuatan notulensi rapat dinas, susunan acara, absensi kehadiran, dan matriks tindak lanjut (action items) saat ini sedang disiapkan sesuai standar tata naskah dinas Badan Kepegawaian Negara.
      </p>

      <!-- Action Buttons -->
      <div style="display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 1rem;">
        <a href="/portal" class="btn btn-secondary" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; font-weight: 600; font-size: 0.875rem; text-decoration: none;">
          <svg style="width: 1.1rem; height: 1.1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          <span>Kembali ke Menu Utama</span>
        </a>
        <a href="/generator" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; font-weight: 600; font-size: 0.875rem; text-decoration: none;">
          <svg style="width: 1.1rem; height: 1.1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
          <span>Buka Pembuat Infografis</span>
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('layouts/footer') %>
