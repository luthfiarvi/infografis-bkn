# Server Port
PORT=3000

# Session Secret Key
SESSION_SECRET=bkn_secret_key_session_secure_2026_jakarta

# Database Configuration (PostgreSQL)
# Jika kredensial PostgreSQL tersedia, aktifkan USE_POSTGRES=true
USE_POSTGRES=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bkn_infografis
DB_USER=postgres
DB_PASSWORD=postgres
# Atau gunakan single connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bkn_infografis

# Mode Fallback: Jika USE_POSTGRES=false atau koneksi PostgreSQL gagal,
# sistem otomatis mengaktifkan database SQLite lokal di ./data/bkn_infografis.sqlite
